      "id": "da4be9d6-b162-4bef-b52c-11e7b9441920",
      "name": "Get senders"
    },
    {
      "parameters": {
        "jsCode": "const norm = s => String(s || '').toLowerCase().trim();\n\nconst senders = $input.all()\n  .map(i => i.json)\n  .filter(r => r.sender && ['trash', 'delete'].includes(norm(r.action)))\n  .map(r => norm(r.sender));\n\nconst chunks = [];\nfor (let i = 0; i < senders.length; i += 40) {\n  chunks.push({\n    json: {\n      query: 'in:anywhere -in:sent -in:trash -is:starred -is:important from:(' + senders.slice(i, i + 40).join(' OR ') + ')',\n      count: senders.slice(i, i + 40).length\n    }\n  });\n}\nreturn chunks;"
      },
