    {
      "parameters": {
        "jsCode": "const TABLE_NODE = 'Get senders';   // must match the node's name on the canvas exactly\n\nconst norm = s => String(s || '').toLowerCase().trim();\n\nconst rules = $(TABLE_NODE).all()\n  .map(i => i.json)\n  .filter(r => r.sender && ['trash', 'delete'].includes(norm(r.action)))\n  .map(r => norm(r.sender));\n\nconst fullAddresses = new Set(rules.filter(s => s.includes('@') && !s.startsWith('@')));\nconst domains = rules\n  .filter(s => !s.includes('@') || s.startsWith('@'))\n  .map(s => s.replace(/^@/, ''));\n\nconst out = [];\nfor (const item of $input.all()) {\n  const m = item.json;\n  const addr = norm(m.from?.emailAddress?.address || (typeof m.from === 'string' ? m.from : ''));\n  if (!addr) continue;\n  const domain = addr.split('@')[1] || '';\n  const hit = fullAddresses.has(addr)\n    || domains.some(d => domain === d || domain.endsWith('.' + d));\n  if (hit) {\n    out.push({ json: { id: m.id, sender: addr, subject: m.subject || '' } });\n  }\n}\nreturn out;"
      },
